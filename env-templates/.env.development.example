# ==========================================================================
# DEVELOPMENT environment — local machine / dev Supabase project
# Copy to apps/web/.env.local and fill in from your DEV Supabase project
# Dashboard: https://supabase.com/dashboard/project/<your-dev-project-ref>/settings/api
# ==========================================================================

NEXT_PUBLIC_SUPABASE_URL=https://<dev-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<dev-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<dev-service-role-key>   # server-only, never expose to client

DATABASE_URL=postgresql://postgres:<dev-db-password>@db.<dev-project-ref>.supabase.co:5432/postgres

NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
