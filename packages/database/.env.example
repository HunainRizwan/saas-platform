# Copy this file to packages/database/.env and fill in your real value.
# This is read by `npm run db:migrate --workspace=packages/database` and by
# `drizzle-kit generate`/`drizzle-kit studio` — both load it automatically
# via the `dotenv/config` import in scripts/migrate.ts and drizzle.config.ts.
#
# This is a SEPARATE .env file from apps/web/.env.local — each workspace
# package loads its own. Use the same DATABASE_URL value in both.

DATABASE_URL=postgresql://postgres:<your-db-password>@db.<your-project-ref>.supabase.co:5432/postgres
